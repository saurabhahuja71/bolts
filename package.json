{
  "name": "opencode-ai",
  "version": "0.1.0",
  "description": "An open-source AI coding agent written in TypeScript + Bun. Terminal-first with a modern TUI.",
  "type": "module",
  "module": "src/index.ts",
  "main": "dist/index.js",
  "bin": {
    "opencode": "./dist/index.js"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun run scripts/build.ts",
    "start": "bun run dist/index.js",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md"
  ],
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "cli",
    "tui",
    "bun",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^1.1.0",
    "@ai-sdk/google": "^1.1.0",
    "@ai-sdk/openai": "^1.1.0",
    "@ai-sdk/openai-compatible": "^0.1.0",
    "ai": "^4.1.0",
    "better-sqlite3": "^11.7.0",
    "commander": "^13.0.0",
    "diff": "^7.0.0",
    "drizzle-orm": "^0.38.0",
    "ink": "^5.2.0",
    "pino": "^9.5.0",
    "react": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/bun": "^1.3.14",
    "@types/diff": "^6.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "drizzle-kit": "^0.30.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}